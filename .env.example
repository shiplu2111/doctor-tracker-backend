# Rename/move to server/.env.example (copy to server/.env for local dev)

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# CORS / cookies
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TTL=15m
REFRESH_TTL=7d

# Seed admin (used by npm run seed:admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-12345

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me
MEILI_SEARCH_KEY=
MEILI_INDEX_PREFIX=dt_

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Optional (P2): email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
